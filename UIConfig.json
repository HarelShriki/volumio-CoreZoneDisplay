{
  "page": {
    "label": "TRANSLATE.PAGE_TITLE"
  },
  "sections": [
    {
      "id": "section_core_zone_settings",
      "element": "section",
      "label": "TRANSLATE.SECTION_TITLE",
      "icon": "fa-desktop",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "saveSettings"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": [
          "openSetting1",
          "displayMode",
          "openSetting2",
          "screensaverEnabled",
          "idleTimeoutSec",
          "openSetting3",
          "selectedClock",
          "openSetting4",
          "radio1Name",
          "radio1Url",
          "radio2Name",
          "radio2Url",
          "radio3Name",
          "radio3Url",
          "radio4Name",
          "radio4Url",
          "radio5Name",
          "radio5Url",
          "openSetting5"
        ]
      },
      "content": [
        {
          "id": "openSetting1",
          "element": "switch",
          "doc": "TRANSLATE.OPEN_SETTING_DOC",
          "label": "TRANSLATE.SETTING_1_HEADER",
          "value": false
        },
        {
          "id": "displayMode",
          "element": "select",
          "doc": "TRANSLATE.DISPLAY_MODE_DOC",
          "label": "TRANSLATE.DISPLAY_MODE",
          "visibleIf": {
            "field": "openSetting1",
            "value": true
          },
          "value": {
            "value": "screensaver_only",
            "label": "Screensaver Only (Clock Mode)"
          },
          "options": [
            {
              "value": "screensaver_only",
              "label": "Screensaver Only (Clock Mode)"
            },
            {
              "value": "full_ui",
              "label": "Full Menu + Screensaver"
            }
          ]
        },
        {
          "id": "openSetting2",
          "element": "switch",
          "doc": "TRANSLATE.OPEN_SETTING_DOC",
          "label": "TRANSLATE.SETTING_2_HEADER",
          "value": false
        },
        {
          "id": "screensaverEnabled",
          "element": "switch",
          "doc": "TRANSLATE.ENABLE_SCREENSAVER_DOC",
          "label": "TRANSLATE.ENABLE_SCREENSAVER",
          "visibleIf": {
            "field": "openSetting2",
            "value": true
          },
          "value": true
        },
        {
          "id": "preventScreensaverWhilePlaying",
          "element": "switch",
          "doc": "TRANSLATE.PREVENT_SCREENSAVER_PLAYING_DOC",
          "label": "TRANSLATE.PREVENT_SCREENSAVER_PLAYING",
          "visibleIf": {
            "field": "openSetting2",
            "value": true
          },
          "value": true
        },
        {
          "id": "idleTimeoutSec",
          "element": "input",
          "type": "number",
          "doc": "TRANSLATE.IDLE_TIMEOUT_DOC",
          "label": "TRANSLATE.IDLE_TIMEOUT_SEC",
          "visibleIf": {
            "field": "openSetting2",
            "value": true
          },
          "value": 60
        },
        {
          "id": "openSetting3",
          "element": "switch",
          "doc": "TRANSLATE.OPEN_SETTING_DOC",
          "label": "TRANSLATE.SETTING_3_HEADER",
          "value": false
        },
        {
          "id": "selectedClock",
          "element": "select",
          "doc": "TRANSLATE.ACTIVE_CLOCK_DOC",
          "label": "TRANSLATE.ACTIVE_CLOCK",
          "visibleIf": {
            "field": "openSetting3",
            "value": true
          },
          "value": {
            "value": "MainClockSelector.html",
            "label": "MainClockSelector.html"
          },
          "options": [
            {
              "value": "MainClockSelector.html",
              "label": "MainClockSelector.html"
            }
          ]
        },
        {
          "id": "openSetting4",
          "element": "switch",
          "doc": "TRANSLATE.OPEN_SETTING_DOC",
          "label": "TRANSLATE.SETTING_4_HEADER",
          "value": false
        },
