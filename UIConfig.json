          "visibleIf": {
            "field": "openSetting4",
            "value": true
          },
          "value": "Eco 99 FM"
        },
        {
          "id": "radio3Url",
          "element": "input",
          "type": "text",
          "label": "TRANSLATE.RADIO_3_URL",
