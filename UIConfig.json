{
  "page": {
    "label": "TRANSLATE.PAGE_TITLE"
  },
  "sections": [
    {
      "id": "section_display_screensaver",
      "element": "section",
      "label": "TRANSLATE.SECTION_DISPLAY_TITLE",
      "icon": "fa-desktop",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "saveDisplaySettings"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": [
          "screensaverEnabled",
          "idleTimeoutSec",
          "selectedClock"
        ]
      },
      "content": [
        {
          "id": "screensaverEnabled",
          "element": "switch",
          "doc": "TRANSLATE.ENABLE_SCREENSAVER_DOC",
          "label": "TRANSLATE.ENABLE_SCREENSAVER",
          "value": true
        },
        {
          "id": "idleTimeoutSec",
          "element": "input",
          "type": "number",
          "doc": "TRANSLATE.IDLE_TIMEOUT_DOC",
          "label": "TRANSLATE.IDLE_TIMEOUT_SEC",
          "value": 60
        },
        {
          "id": "selectedClock",
          "element": "select",
          "doc": "TRANSLATE.ACTIVE_CLOCK_DOC",
          "label": "TRANSLATE.ACTIVE_CLOCK",
          "value": {
            "value": "MainClockSelector.html",
            "label": "MainClockSelector.html"
          },
          "options": [
            {
              "value": "MainClockSelector.html",
              "label": "MainClockSelector.html"
            }
          ]
        }
      ]
    },
    {
      "id": "section_radio_presets",
