          "value": "http://stream.radioparadise.com/aac-320"
        },
        {
          "id": "radio5Name",
          "element": "input",
          "type": "text",
          "label": "TRANSLATE.RADIO_5_NAME",
          "visibleIf": {
            "field": "openSetting4",
            "value": true
          },
          "value": "SomaFM Groove Salad"
        },
        {
          "id": "radio5Url",
          "element": "input",
          "type": "text",
          "label": "TRANSLATE.RADIO_5_URL",
          "visibleIf": {
            "field": "openSetting4",
            "value": true
