{
  "page": {
    "label": "TRANSLATE.PAGE_TITLE"
  },
  "sections": [
    {
      "id": "section_display",
      "element": "section",
      "label": "TRANSLATE.SECTION_DISPLAY",
      "description": "TRANSLATE.SECTION_DISPLAY_DESC",
      "icon": "fa-desktop",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "configSaveDisplay"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": ["displayMode"]
      },
      "content": [
        {
          "id": "displayMode",
          "element": "select",
          "doc": "TRANSLATE.DISPLAY_MODE_DOC",
          "label": "TRANSLATE.DISPLAY_MODE",
          "value": {
            "value": "screensaver_only",
            "label": "TRANSLATE.DISPLAY_MODE_SCREENSAVER_ONLY"
          },
          "options": [
            {
              "value": "screensaver_only",
              "label": "TRANSLATE.DISPLAY_MODE_SCREENSAVER_ONLY"
            },
            {
              "value": "full_ui",
              "label": "TRANSLATE.DISPLAY_MODE_FULL_UI"
            }
          ]
        }
      ]
    },
    {
      "id": "section_screensaver",
      "element": "section",
      "label": "TRANSLATE.SECTION_SCREENSAVER",
      "description": "TRANSLATE.SECTION_SCREENSAVER_DESC",
      "icon": "fa-moon-o",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "configSaveScreensaver"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": ["screensaverEnabled", "preventScreensaverWhilePlaying", "idleTimeoutSec"]
      },
      "content": [
        {
          "id": "screensaverEnabled",
          "element": "switch",
          "doc": "TRANSLATE.ENABLE_SCREENSAVER_DOC",
          "label": "TRANSLATE.ENABLE_SCREENSAVER",
          "value": true
        },
        {
          "id": "preventScreensaverWhilePlaying",
          "element": "switch",
          "doc": "TRANSLATE.PREVENT_SCREENSAVER_PLAYING_DOC",
          "label": "TRANSLATE.PREVENT_SCREENSAVER_PLAYING",
          "visibleIf": {
            "field": "screensaverEnabled",
            "value": true
          },
          "value": true
        },
        {
          "id": "idleTimeoutSec",
          "element": "input",
          "type": "number",
          "doc": "TRANSLATE.IDLE_TIMEOUT_DOC",
          "label": "TRANSLATE.IDLE_TIMEOUT_SEC",
          "visibleIf": {
            "field": "screensaverEnabled",
            "value": true
          },
          "value": 60
        }
      ]
    },
    {
      "id": "section_clock",
      "element": "section",
      "label": "TRANSLATE.SECTION_CLOCK",
      "description": "TRANSLATE.SECTION_CLOCK_DESC",
      "icon": "fa-clock-o",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "configSaveClock"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": ["selectedClock"]
      },
      "content": [
        {
          "id": "selectedClock",
          "element": "select",
          "doc": "TRANSLATE.ACTIVE_CLOCK_DOC",
          "label": "TRANSLATE.ACTIVE_CLOCK",
          "value": {
            "value": "MainClockSelector.html",
            "label": "MainClockSelector.html"
          },
          "options": [
            {
              "value": "MainClockSelector.html",
              "label": "MainClockSelector.html"
            }
          ]
        }
      ]
    },
    {
      "id": "section_radio",
      "element": "section",
      "label": "TRANSLATE.SECTION_RADIO",
      "description": "TRANSLATE.SECTION_RADIO_DESC",
      "icon": "fa-music",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/core_zone_display",
        "method": "configSaveRadio"
      },
      "saveButton": {
        "label": "TRANSLATE.SAVE",
        "data": [
          "radio1Name",
          "radio1Url",
          "radio2Name",
          "radio2Url",
          "radio3Name",
          "radio3Url",
          "radio4Name",
          "radio4Url",
          "radio5Name",
          "radio5Url"
        ]
      },
      "content": [
        { "id": "radio1Name", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_1_NAME", "value": "Kan 88" },
        { "id": "radio1Url", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_1_URL", "value": "https://27783.live.streamtheworld.com/KAN_88.mp3" },
        { "id": "radio2Name", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_2_NAME", "value": "Galgalatz" },
        { "id": "radio2Url", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_2_URL", "value": "https://glzwizzlv.bynetcdn.com/glglz_mp3" },
        { "id": "radio3Name", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_3_NAME", "value": "Eco 99 FM" },
        { "id": "radio3Url", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_3_URL", "value": "https://eco01.mediacast.co.il/ecolive/99fm_aac/icecast.audio" },
        { "id": "radio4Name", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_4_NAME", "value": "Radio Paradise" },
        { "id": "radio4Url", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_4_URL", "value": "http://stream.radioparadise.com/aac-320" },
        { "id": "radio5Name", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_5_NAME", "value": "SomaFM Groove Salad" },
        { "id": "radio5Url", "element": "input", "type": "text", "label": "TRANSLATE.RADIO_5_URL", "value": "https://ice1.somafm.com/groovesalad-256-mp3" }
      ]
    },
    {
      "id": "section_links",
      "element": "section",
      "label": "TRANSLATE.SECTION_LINKS",
      "description": "TRANSLATE.SECTION_LINKS_DESC",
      "icon": "fa-link",
      "content": [
        {
          "id": "displayUrl",
          "element": "input",
          "type": "text",
          "label": "TRANSLATE.DISPLAY_URL",
          "doc": "TRANSLATE.DISPLAY_URL_DOC",
          "value": "http://localhost:4004"
        },
        {
          "id": "clockSettingsUrl",
          "element": "input",
          "type": "text",
          "label": "TRANSLATE.CLOCK_SETTINGS_URL",
          "doc": "TRANSLATE.CLOCK_SETTINGS_URL_DOC",
          "value": "http://localhost:4004/clocks/digital/settings.html"
        }
      ]
    }
  ]
}
